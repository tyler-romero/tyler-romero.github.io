<script>
    // Size margin widgets (same-origin iframes) to their content.
    for (const f of document.querySelectorAll("iframe.margin-widget")) {
        const fit = () => {
            const el = f.contentDocument?.querySelector("body > div");
            if (!el) return;
            f.style.height = `${Math.ceil(el.getBoundingClientRect().height)}px`;
            new f.contentWindow.ResizeObserver(() => {
                f.style.height = `${Math.ceil(el.getBoundingClientRect().height)}px`;
            }).observe(el);
        };
        f.addEventListener("load", fit);
        if (f.contentDocument?.readyState === "complete") fit();
    }
</script>
