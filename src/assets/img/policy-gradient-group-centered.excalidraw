      "boundElements": null,
      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "Group mean reward: (0 + 1 + 1 + 0) / 4 = 0.5. Each completion's log-probability\nis pushed in proportion to its advantage A.",
      "originalText": "Group mean reward: (0 + 1 + 1 + 0) / 4 = 0.5. Each completion's log-probability\nis pushed in proportion to its advantage A.",
      "fontSize": 16.67,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-43",
      "type": "text",
      "x": 20.0,
      "y": 513.33,
      "width": 760.0,
      "height": 41.67,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0043",
      "roundness": null,
      "seed": 1014631947,
      "version": 1,
      "versionNonce": 1269686660,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "Along the prefix A and B share (\"17 × 24 = … 340 +\"), their token scores are\nidentical, so the pushes cancel: −0.5 + 0.5 = 0.",
      "originalText": "Along the prefix A and B share (\"17 × 24 = … 340 +\"), their token scores are\nidentical, so the pushes cancel: −0.5 + 0.5 = 0.",
      "fontSize": 16.67,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    }
