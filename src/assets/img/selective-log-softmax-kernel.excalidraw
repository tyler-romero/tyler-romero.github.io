      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "s_new = s * exp(m - m_new)\n      + s' * exp(m' - m_new)",
      "originalText": "s_new = s * exp(m - m_new)\n      + s' * exp(m' - m_new)",
