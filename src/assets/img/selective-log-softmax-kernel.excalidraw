      "link": null,
      "locked": false,
      "text": "m_new = max(m, m')",
      "originalText": "m_new = max(m, m')",
      "fontSize": 16.0,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
