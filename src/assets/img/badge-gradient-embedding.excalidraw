      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0235",
      "roundness": null,
      "seed": 1638815831,
      "version": 1,
      "versionNonce": 892420494,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "Confident prediction: p ≈ ŷ, so g(x) is small.   Unsure prediction: p − ŷ is large, so g(x) is large.",
      "originalText": "Confident prediction: p ≈ ŷ, so g(x) is small.   Unsure prediction: p − ŷ is large, so g(x) is large.",
      "fontSize": 18.67,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-236",
      "type": "text",
      "x": 20.0,
      "y": 510.0,
      "width": 952.0,
      "height": 23.33,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0236",
      "roundness": null,
      "seed": 1048351071,
      "version": 1,
      "versionNonce": 96854577,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "The direction of g(x) comes from h, so similar-looking inputs get similar embeddings.",
      "originalText": "The direction of g(x) comes from h, so similar-looking inputs get similar embeddings.",
