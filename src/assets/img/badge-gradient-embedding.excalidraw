    {
      "id": "text-235",
      "type": "text",
      "x": 20.0,
      "y": 480.0,
      "width": 1131.2,
      "height": 23.33,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
