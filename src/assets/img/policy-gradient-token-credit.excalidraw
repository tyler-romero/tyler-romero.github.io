      "seed": 689461232,
      "version": 1,
      "versionNonce": 1270864074,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790380000000,
      "link": null,
      "locked": false,
      "text": "Violet: the gradient of each chosen token's log-probability with respect to its own logit, exactly 1 − p. Arrows are drawn to that length.\nThe zoom-ins show that gradient on every logit. The score ∇θ log p carries it back to every parameter; the actual step also scales with the learning rate.",
      "originalText": "Violet: the gradient of each chosen token's log-probability with respect to its own logit, exactly 1 − p. Arrows are drawn to that length.\nThe zoom-ins show that gradient on every logit. The score ∇θ log p carries it back to every parameter; the actual step also scales with the learning rate.",
      "fontSize": 14.67,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    }
