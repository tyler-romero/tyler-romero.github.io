    {
      "id": "text-185",
      "type": "text",
      "x": 13.33,
      "y": 893.33,
      "width": 1355.2,
      "height": 36.67,
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
